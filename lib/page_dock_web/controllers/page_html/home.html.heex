<div class="font-sans text-[15px] leading-[1.6] text-muted bg-bg antialiased min-h-screen">
  <div class="glow">
    <div class="max-w-[1080px] mx-auto px-6">
      <header class="flex items-center justify-between h-16">
        <a
          href="#"
          class="inline-flex items-center gap-2 text-text font-medium text-[15px] no-underline"
        >
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="2" y="11" width="16" height="3" rx="1" fill="#0D0E10" />
            <rect x="4.5" y="4" width="11" height="7" rx="1.5" fill="#5E6AD2" />
            <rect x="2" y="15.5" width="16" height="1.5" rx="0.75" fill="#9A9EA5" />
          </svg>
          Pagedock
        </a>
        <nav class="flex items-center gap-1">
          <a
            href="#how"
            class="hidden md:inline px-3 py-1.5 rounded-md text-[14px] text-muted hover:text-text hover:bg-black/[0.04] no-underline transition-colors"
          >
            How it works
          </a>
          <a
            href="#eu"
            class="hidden md:inline px-3 py-1.5 rounded-md text-[14px] text-muted hover:text-text hover:bg-black/[0.04] no-underline transition-colors"
          >
            Hosting
          </a>
          <a
            href="#included"
            class="hidden md:inline px-3 py-1.5 rounded-md text-[14px] text-muted hover:text-text hover:bg-black/[0.04] no-underline transition-colors"
          >
            What's included
          </a>
          <%= if @current_scope do %>
            <span class="hidden sm:inline px-3 text-[13px] text-muted max-w-[180px] truncate">
              {@current_scope.user.email}
            </span>
            <a href={~p"/users/settings"} class="ml-2 btn-secondary h-8 px-3 no-underline">
              Settings
            </a>
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="btn-primary h-8 px-3 no-underline"
            >
              Log out
            </.link>
          <% else %>
            <a href={~p"/users/log-in"} class="ml-2 btn-secondary h-8 px-3 no-underline">
              Log in
            </a>
            <a href={~p"/users/register"} class="btn-primary h-8 px-3 no-underline">Sign up</a>
          <% end %>
        </nav>
      </header>

      <section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-visible">
        <%!-- background: Gdańsk cranes, right side, behind the headline --%>
