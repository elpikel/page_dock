    <section id="signup" class="py-24 border-t border-border">
      <div class="card p-8 md:p-12 grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-10 items-center">
        <div>
          <h2 class="h-display text-[30px] md:text-[36px] leading-[1.1] mb-3">
            Dock your first site.
          </h2>
          <p class="text-[16px] max-w-[42ch]">
            Create an account, paste a repo URL, and you'll have a live address before you finish reading the next page. Free while in beta.
          </p>
        </div>
        <form
          class="flex flex-col sm:flex-row gap-2"
          onsubmit="event.preventDefault(); this.querySelector('input').value=''; alert('Thanks — we will email you when your account is ready.');"
        >
          <label for="email" class="sr-only">Email address</label>
          <input
            id="email"
            type="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            class="flex-1 min-w-0 h-10 px-3 rounded-lg bg-raised border border-border2 text-text text-sm placeholder:text-faint focus:border-accent focus:outline-none"
          />
          <button type="submit" class="btn-primary whitespace-nowrap">Create account</button>
        </form>
      </div>
    </section>

